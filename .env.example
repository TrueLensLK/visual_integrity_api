# Google Gemini API Key (used by LLM Judge, Debate, and Vision Agent)
# Get one at https://aistudio.google.com/
GOOGLE_AI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# Groq API Key (fallback for LLM Judge)
# Get one at https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API Key (fallback for debate system)
# Get one at https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Set to "false" to disable LLM Judge and use only rule-based system
ENABLE_LLM_JUDGE=true

# Optional: override AI metadata keyword scan (comma-separated)
AI_METADATA_KEYWORDS=midjourney,stable diffusion,openai,firefly
